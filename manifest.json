{
  "schemaVersion": 1,
  "id": "io.github.rektyrowdyy.whatsapp",
  "name": "WhatsApp",
  "version": "1.0.0",
  "author": "RektyRowdyy",
  "license": "MIT",
  "description": "WhatsApp Web bar icon with an unread indicator dot. Click to focus (or launch) WhatsApp, right-click for a sender list.",
  "homepage": "https://github.com/RektyRowdyy/whatsapp",
  "repository": "https://github.com/RektyRowdyy/whatsapp",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "WhatsApp",
    "description": "Bar icon + unread dot for WhatsApp Web. Click to focus/launch, right-click for senders.",
    "category": "Communication",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "autoLaunch": true,
      "appNamePattern": "Chromium|Google Chrome|Brave|Chrome",
      "matchUrl": "web.whatsapp.com",
      "windowClassPattern": "whatsapp"
    },
    "schema": [
      {
        "key": "autoLaunch",
        "type": "boolean",
        "label": "Launch WhatsApp on shell start",
        "defaultValue": true
      },
      {
        "key": "appNamePattern",
        "type": "string",
        "label": "Notification app-name pattern (regex)",
        "defaultValue": "Chromium|Google Chrome|Brave|Chrome"
      },
      {
        "key": "matchUrl",
        "type": "string",
        "label": "Notification body match (substring/regex)",
        "defaultValue": "web.whatsapp.com"
      },
      {
        "key": "windowClassPattern",
        "type": "string",
        "label": "WhatsApp window class/app-id pattern (regex)",
        "defaultValue": "whatsapp"
      }
    ]
  }
}
